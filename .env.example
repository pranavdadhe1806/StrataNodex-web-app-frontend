# StrataNodex Web App — Environment Variables
# Copy to .env.local for local development

# ── Backend API ──────────────────────────────────────────────────────────────
# Local:      http://localhost:3000/api
# Production: https://stratanodex-backend.onrender.com/api
VITE_API_URL=http://localhost:3000/api

# ── Landing page (auth redirect target) ─────────────────────────────────────
# Local:      http://localhost:3001
# Production: https://stratanodex-landing-page.vercel.app
VITE_LANDING_URL=http://localhost:3001
